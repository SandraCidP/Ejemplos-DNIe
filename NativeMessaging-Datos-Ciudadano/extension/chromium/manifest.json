{
    "manifest_version": 3,
    "name": "DNIe: datos y firma (ejemplo)",
    "version": "1.0.0",
    "description": "Permite a las páginas autorizadas leer los datos del DNI electrónico y firmar con él mediante un programa instalado en el equipo.",
    "key": "",
    "permissions": ["nativeMessaging"],
    "background": {
        "service_worker": "fondo.js"
    },
    "content_scripts": [
        {
            "matches": ["http://localhost/*"],
            "js": ["contenido.js"],
            "run_at": "document_start"
        }
    ]
}
