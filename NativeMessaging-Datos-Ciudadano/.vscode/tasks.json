{
    // ========================================================================
    //  tasks.json - Tareas de Visual Studio Code para el ejemplo de Native
    //  Messaging del DNIe.
    //
    //  VS Code no trae compilador. Estas tareas llaman a los mismos scripts
    //  que se usan desde la consola (carpeta scripts\), que a su vez localizan
    //  MSBuild. Por eso hacen falta Visual Studio 2022 o sus Build Tools, con
    //  las herramientas de C++, igual que sin VS Code.
    //
    //  Cómo usarlas:
    //    Ctrl+Mayús+B                    ->  compila (la tarea por defecto)
    //    Terminal > Ejecutar tarea...    ->  elegir cualquiera de las demás
    //
    //  Solo funcionan en Windows.
    // ========================================================================
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Compilar (Release, x86, x64 y ARM64)",
            "detail": "scripts\\compilar.cmd: genera bin\\<plataforma>\\Release\\DNIeDatos.exe",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "scripts\\compilar.cmd"],
            // "$msCompile" lleva los errores y avisos de MSBuild al panel
            // "Problemas", con enlace a la línea del código.
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Compilar solo x64",
            "detail": "scripts\\compilar.cmd x64",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "scripts\\compilar.cmd", "x64"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Registrar el programa en los navegadores",
            "detail": "scripts\\registrar.cmd: Chrome, Edge y Firefox, para el usuario actual",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "scripts\\registrar.cmd"],
            "problemMatcher": []
        },
        {
            "label": "Desregistrar el programa",
            "detail": "scripts\\desregistrar.cmd",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "scripts\\desregistrar.cmd"],
            "problemMatcher": []
        },
        {
            "label": "Probar el programa sin navegador",
            "detail": "scripts\\probar.ps1: envía {\"operacion\":\"informacion\"} y muestra la respuesta",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts\\probar.ps1",
                     "{\"operacion\":\"informacion\"}"],
            "problemMatcher": []
        },
        {
            "label": "Servir la página de ejemplo",
            "detail": "web\\servir.cmd: http://localhost:8081/ (se detiene con Ctrl+C en el terminal)",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "web\\servir.cmd"],
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
