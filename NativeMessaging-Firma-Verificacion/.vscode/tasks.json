{
    // ========================================================================
    //  tasks.json - Tareas de Visual Studio Code para este proyecto.
    //
    //  VS Code no trae compilador. Estas tareas se limitan a llamar a los
    //  mismos scripts que se usan desde la consola, que a su vez localizan
    //  MSBuild. Por eso hacen falta Visual Studio 2022 o sus Build Tools,
    //  igual que sin VS Code.
    //
    //  Cómo usarlas:
    //    Ctrl+Mayús+B                    ->  compila (la tarea por defecto)
    //    Terminal > Ejecutar tarea...    ->  elegir cualquiera de las demás
    //
    //  Todas son de tipo "process" y llaman a cmd.exe o a powershell.exe con
    //  una ruta relativa. Así no importa que la carpeta del proyecto tenga
    //  espacios o acentos, ni cuál sea la consola por defecto de VS Code.
    //
    //  Solo funcionan en Windows.
    // ========================================================================
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Compilar (Release)",
            "detail": "scripts\\compilar.cmd: genera bin\\x64\\Release (y ARM64 si hay herramientas)",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "scripts\\compilar.cmd"],
            // "$msCompile" lee los errores y avisos de MSBuild y los lleva al
            // panel "Problemas", con enlace a la línea del código.
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Registrar el programa de firma",
            "detail": "scripts\\registrar.cmd: lo da a conocer a Chrome, Edge y Firefox",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "scripts\\registrar.cmd"],
            "problemMatcher": []
        },
        {
            "label": "Desregistrar el programa de firma",
            "detail": "scripts\\desregistrar.cmd: deshace el registro",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "scripts\\desregistrar.cmd"],
            "problemMatcher": []
        },
        {
            "label": "Probar el programa sin navegador",
            "detail": "scripts\\probar-anfitrion.ps1: envía la petición \"version\" y muestra la respuesta",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts\\probar-anfitrion.ps1"],
            "problemMatcher": []
        },
        {
            "label": "Servir la página de ejemplo",
            "detail": "web\\servir.cmd: http://localhost:8080/",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "web\\servir.cmd"],
            "problemMatcher": []
        }
    ]
}
