<?xml version="1.0" encoding="utf-8"?>
<!--
  DNIeAnfitrion.vcxproj - Proyecto de Visual Studio / MSBuild del anfitrión.

  Genera DNIeAnfitrion.exe en  bin\<Plataforma>\<Configuración>\  (en la raíz
  del proyecto). Plataformas:

    x64     Procesadores Intel/AMD de 64 bits (lo habitual).
    ARM64   Procesadores ARM de 64 bits.

  Se puede abrir con Visual Studio 2022 o compilar desde la línea de comandos
  con scripts\compilar.cmd.

  Requisitos: herramientas de C++ v143 y SDK de Windows 10/11. Para ARM64
  hacen falta además los componentes de C++ de esa plataforma. NO
  necesita ATL ni MFC.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6E0B7C52-3D5A-4F4E-9C1B-2A8D1F7E4B90}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>DNIeAnfitrion</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Por defecto, MSBuild solo deja compilar para ARM64 aplicaciones de la
         Tienda. Esta propiedad le dice que el nuestro es un programa de
         escritorio normal y que aun así lo queremos para ARM64. -->
    <WindowsSDKDesktopARM64Support>true</WindowsSDKDesktopARM64Support>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- Carpetas de salida, fuera de la carpeta del código. -->
    <OutDir>$(MSBuildProjectDirectory)\..\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\..\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>DNIeAnfitrion</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- /utf-8: los .cpp están guardados en UTF-8 (textos con acentos). -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <!-- Programa "de ventanas" (wWinMain), no de consola: así no aparece
           una ventana de consola cuando el navegador lo arranca. -->
      <SubSystem>Windows</SubSystem>
      <!-- El .exe guarda dentro la ruta de su archivo .pdb. Con esta opción
           guarda solo el nombre del archivo, y no la carpeta (ni el nombre
           de usuario de Windows) del equipo donde se compiló. -->
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
      <!-- crypt32: certificados, PKCS#7 y Base64.  cryptui: diálogo de
           selección de certificado.  ncrypt: CNG.  winscard: lectura del ATR
           de la tarjeta.  comdlg32: diálogo "Abrir". -->
      <AdditionalDependencies>crypt32.lib;cryptui.lib;ncrypt.lib;winscard.lib;comdlg32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <!-- Declara que el programa tiene en cuenta la escala de la pantalla
           (125 %, 150 %...). Sin esto, Windows ampliaría los diálogos como
           una imagen y se verían borrosos. -->
      <EnableDpiAwareness>true</EnableDpiAwareness>
    </Manifest>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Biblioteca de C++ enlazada estáticamente: el .exe no depende de que
           el equipo tenga instalado el "Visual C++ Redistributable". -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Enlace estático de la biblioteca de C++ (ver la nota en Debug):
           es lo que hace que el .exe que se distribuye no dependa de nada. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Crypto.cpp" />
    <ClCompile Include="Main.cpp" />
    <ClCompile Include="PinDialog.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Crypto.h" />
    <ClInclude Include="Module.h" />
    <ClInclude Include="PinDialog.h" />
    <ClInclude Include="resource.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="DNIeAnfitrion.rc" />
  </ItemGroup>
  <ItemGroup>
    <!-- Imagen del diálogo del PIN; la incrusta DNIeAnfitrion.rc. -->
    <Image Include="res\seguro.ico" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
