// ActiveXDNIe.rc (UTF-8)
#pragma code_page(65001)
#include "resource.h"
#include "winres.h"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "Comments", "Control ActiveX para el manejo de la tarjeta DNIe (DNIe 3.0 y DNIe 4.0)."
            VALUE "CompanyName", "FNMT-RCM"
            VALUE "FileDescription", "ActiveX DNIe"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ActiveXDNIe"
            VALUE "LegalCopyright", "Copyright (C) 2026 FNMT-RCM"
            VALUE "OLESelfRegister", ""
            VALUE "OriginalFilename", "ActiveXDNIe.dll"
            VALUE "ProductName", "ActiveX DNIe"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0xc0a, 1200
    END
END

IDR_ACTIVEXDNIE  REGISTRY  "ActiveXDNIe.rgs"
IDR_DLL_ADMIN    REGISTRY  "DLL_ADMIN.rgs"

STRINGTABLE
BEGIN
    IDS_PROJNAME "ActiveXDNIe"
END

1 TYPELIB "ActiveXDNIe.tlb"

// Diálogo del PIN (PinDialog.cpp).
// Mismos controles; aspecto actualizado (Segoe UI, zona blanca y franja de botones) y el texto de
// arriba lo pone el código según la operación (IDC_PIN_TEXT).
IDI_PIN ICON "res\\candado.ico"

IDD_PIN DIALOGEX 0, 0, 270, 126
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DNI electrónico - PIN"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL "", IDC_PIN_ICON, "Static", SS_ICON, 12, 12, 0, 0
    LTEXT "Introduzca el PIN de su DNIe para firmar", IDC_PIN_TEXT, 52, 11, 208, 24
    EDITTEXT IDC_PIN_EDIT, 52, 38, 208, 15, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_PIN_HINT, 52, 57, 208, 10
    AUTOCHECKBOX "&Mostrar el PIN", IDC_PIN_SHOW, 52, 71, 208, 11, WS_TABSTOP
    // Franja de los botones desde y = 92 (FOOTER_TOP_DLU en PinDialog.cpp)
    DEFPUSHBUTTON "Aceptar", IDOK, 148, 101, 54, 15, WS_TABSTOP
    PUSHBUTTON "Cancelar", IDCANCEL, 206, 101, 54, 15, WS_TABSTOP
END
