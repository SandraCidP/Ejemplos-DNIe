{
    // ========================================================================
    //  c_cpp_properties.json - Configuración de IntelliSense (extensión
    //  "C/C++" de Microsoft). No interviene en la compilación: solo sirve
    //  para que el editor entienda el código (autocompletado, ir a la
    //  definición, subrayado de errores).
    //
    //  Repite lo esencial de DNIeActiveX.vcxproj:
    //    - includePath: la carpeta del código y obj\Win32\Release, donde MIDL
    //      deja la cabecera generada DNIeActiveX_h.h. Esa cabecera NO existe
    //      hasta haber compilado una vez; hasta entonces el editor subraya
    //      su #include en Signer.h.
    //    - defines: las mismas macros con las que compila el proyecto
    //      (Unicode y DLL de Windows).
    //    - /utf-8: los .cpp están guardados en UTF-8.
    //
    //  No se indica "compilerPath": la extensión localiza por sí misma el
    //  compilador de Visual Studio o de las Build Tools.
    // ========================================================================
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/src/DNIeActiveX",
                "${workspaceFolder}/obj/Win32/Release"
            ],
            "defines": [
                "_WINDOWS",
                "_USRDLL",
                "UNICODE",
                "_UNICODE",
                "NDEBUG"
            ],
            "compilerArgs": ["/utf-8"],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x86"
        }
    ]
}
